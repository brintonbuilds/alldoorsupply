 /* ---------- clash checks, per leaf ---------- */
 function hit(a,b){return a&&b&&a.x<b.x+b.w&&b.x<a.x+a.w&&a.y<b.y+b.h&&b.y<a.y+a.h;}
 function grow(a,d){return {x:a.x-d,y:a.y-d,w:a.w+2*d,h:a.h+2*d};}
 var emn=rmin==45&&S.fam=="AF45"?4:5;
 var sep=rated?(S.c=="8120-MO"?5:S.scl?1.25:(S.fam=="AF45"?4:(S.fam=="RMC"?5:3.25))):0;
 var lr0=act.hinge=="L",zoneTop=DH-Math.max(lockCL||0,dbCL||0)-(mort?4:2),zoneBot=DH-(lockCL||dbCL||0)+(mort?4:2);
 var zone=(hasLock||hasDB)?{x:lr0?act.w-bs-1.5:0,y:zoneTop,w:bs+1.5,h:zoneBot-zoneTop}:null;
 var bad={};
 for(var lf=0;lf<leaves.length;lf++){var LFx=leaves[lf],Lr=liteRects(LFx),Ur=louRect(LFx);
  for(i=0;i<Lr.length;i++){var r=Lr[i],tg=LC>1?"Lite "+r.n+": ":"";
   if(r.y<emn&&!bad["t"+r.n]){W.push(tg+"top rail above the opening is "+FF(r.y)+" ("+emn+"\" min).");bad["t"+r.n]=1;}
   var botR=DH-r.y-r.h;if(botR<emn&&!bad["b"+r.n]){W.push(tg+"bottom rail below the opening is "+FF(botR)+" ("+emn+"\" min).");bad["b"+r.n]=1;}
   if((r.x<0||r.x+r.w>LFx.w)&&!bad["f"+r.n]){W.push(tg+"the opening doesn't fit in the door width.");bad["f"+r.n]=1;}
   else{var st=Math.min(r.x,LFx.w-r.x-r.w);if(st<emn&&!bad["s"+r.n]){W.push(tg+"stile beside the opening is "+FF(st)+" ("+emn+"\" min).");bad["s"+r.n]=1;}}
   if(LFx===act&&hit(sep?grow(r,sep):r,zone)&&!bad["z"+r.n]){W.push(tg+"the opening runs into the lock / deadbolt prep"+(sep?" ("+FF(sep)+" min clear)":"")+".");bad["z"+r.n]=1;}
   if(hit(r,Ur)&&!bad["u"+r.n]){W.push(tg+"the opening and louver overlap.");bad["u"+r.n]=1;}
   for(j=i+1;j<Lr.length;j++){var r2=Lr[j];
    if(hit(r,r2)){if(!bad["p"+r.n+r2.n]){W.push("Openings "+r.n+" and "+r2.n+" overlap.");bad["p"+r.n+r2.n]=1;}}
    else if(hit(grow(r,2),r2)&&!S.scl&&!bad["q"+r.n+r2.n]){W.push("Openings "+r.n+" and "+r2.n+" are 2\" or less apart: use 6000, 7000 or 7600 construction.");bad["q"+r.n+r2.n]=1;}
    else if(sep&&hit(grow(r,sep),r2)&&!bad["q"+r.n+r2.n]){W.push("Openings "+r.n+" and "+r2.n+": "+FF(sep)+" min between cutouts ("+fire+").");bad["q"+r.n+r2.n]=1;}}}}
 var LrA=liteRects(act);if(hasLite&&LrA.length){var low=LrA[0];for(i=1;i<LrA.length;i++)if(LrA[i].y+LrA[i].h>low.y+low.h)low=LrA[i];
  var gb=DH-(low.y+low.h)+(low.h-low.vh)/2+uc;if(gb>43&&gb<66)N.push("Bottom of glass is "+FF(gb)+" AFF: barrier-free asks 43\" max.");}

