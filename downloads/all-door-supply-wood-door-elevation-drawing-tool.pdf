/* vision openings */
function GRID(ws,hs){var r=[];for(var i=0;i<ws.length;i++)for(var j=0;j<hs.length;j++)r.push([ws[i],hs[j]]);return r;}
var G_NR=GRID([6,12,18,24,30,36],[12,18,24,30,36,42,48,54,60,72]);
var G_FR=GRID([6,12,18,24,30],[12,18,24,30,36,40,54]);
var M_CUT=[[5,35],[6,27],[7,22],[8,32],[8,38],[8,50],[12,12],[18,24],[18,32],[20,32],[22,24],[22,32],[22,36],[24,24],[24,26],[24,30],[24,32],[24,36]];
/* basis: glass = ordered by glass size; cutout = ordered by cutout size; net = ordered by net vision. trim = moulding lap past the cutout (schematic). */
var MOUL=[
 {id:"S",label:"\"S\" standard wood",r:[0],basis:"glass",sizes:G_NR,trim:0.75,glass:["T14","L14","W14","BY"],ab:"S"},
 {id:"F",label:"\"F\" flush wood",r:[0],basis:"glass",sizes:G_NR,trim:0.5,glass:["T14","L14","W14","BY"],ab:"F"},
 {id:"T",label:"\"T\" thermal wood (to 1\" glass)",r:[0],basis:"glass",sizes:G_NR,trim:0.875,glass:["IG34","T14","L14","BY"],ab:"T"},
 {id:"CF",label:"\"CF\" wood w/ clips (20 min)",r:[20],basis:"glass",sizes:G_FR,trim:0.75,glass:["W14","FRC"],ab:"CF"},
 {id:"LXS",label:"\"LXS\" wood, std (20/45 min)",r:[20,45],af:1,basis:"cutout",sizes:G_FR,trim:0.75,glass:["W14","FRC"],ab:"LXS"},
 {id:"LXF",label:"\"LXF\" wood, flush (20/45 min)",r:[20,45],af:1,basis:"cutout",sizes:G_FR,trim:0.5,glass:["W14","FRC"],ab:"LXF"},
 {id:"M",label:"\"M\" metal (20 to 90 min)",r:[20,45,60,90],basis:"cutout",sizes:M_CUT,trim:0.5,metal:1,glass:["W14","FRC"],ab:"M"},
 {id:"CUT",label:"Opening only (glass by others)",r:[0,20,45],basis:"cutout",sizes:G_NR,trim:0,glass:["BY","FRC"],ab:"CUT"},
 {id:"VSIG",label:"Slimline VSIG (STC)",r:[0,20,45],basis:"net",sizes:[[5,20]],trim:1.5,metal:1,glass:["SRL","PYRO"],ab:"VSIG",sr:1}
];
var GLASS={T14:{n:"1/4\" clear tempered",t:0.25,ab:"TEMP."},L14:{n:"1/4\" clear laminated",t:0.25,ab:"LAM."},W14:{n:"1/4\" clear wired",t:0.25,ab:"WIRED",fr:1},
 IG34:{n:"3/4\" sealed unit (2 x 1/8\" tempered)",t:0.75,ab:"I.G.U."},FRC:{n:"Fire-rated ceramic - by others",t:0.25,ab:"F.R.",fr:1},BY:{n:"Glass by others",t:0,ab:""},
 SRL:{n:"Clear laminated (STC, incl.)",t:0.5,ab:"LAM."},PYRO:{n:"Pyrostop 7/8\" (incl.)",t:0.875,ab:"PYRO",fr:1}};
function glassBy(n){for(var k in GLASS)if(GLASS[k].n==n)return GLASS[k];return null;}
var LOUV=[
 {id:"L",label:"\"L\" wood louver, \"S\" moulding",sizes:GRID([12,14,16,18,20,22,24],[8,12,16,20,24,30,36]),trim:0.75},
 {id:"LC",label:"Cutout only (louver by others)",sizes:GRID([12,18,24],[12,18,24,36]),trim:0}
];
var HPV={'6/8 (80")':80,'7/0 (84")':84,'8/0 (96")':96,'9/0 (108")':108,'10/0 (120")':120};
var RMIN={"Non-rated":0,"20 Min.":20,"45 Min.":45,"60 Min.":60,"90 Min.":90};
function molBy(l){for(var i=0;i<MOUL.length;i++)if(MOUL[i].label==l)return MOUL[i];return null;}
function louBy(l){for(var i=0;i<LOUV.length;i++)if(LOUV[i].label==l)return LOUV[i];return null;}
var LMAX=3;
function LK(n,f){return n==1?"Lite "+f:"Lite "+n+" "+f;}
function szLab(a){return FN(a[0])+'" x '+FN(a[1])+'"';}
function parseSz(s){var m=(""+s).match(/^\s*([\d.\/\s-]+?)\s*"?\s*x\s*([\d.\/\s-]+?)\s*"?\s*$/i);if(!m)return null;var a=PF(m[1]),b=PF(m[2]);return (a>0&&b>0)?[a,b]:null;}
/* geometry of one opening from its ordered size: cutout, glass, visible, trim outline */
function molDims(K,w,h,rmin){
 if(K.id=="M")return {cw:w,ch:h,gw:w-1,gh:h-1,vw:w-2,vh:h-2,ex:1,basis:"cutout"};
 if(K.id=="VSIG")return {cw:w+1.5,ch:h+1.5,gw:w+0.75,gh:h+0.75,vw:w,vh:h,ex:0,basis:"net vision"};
 if(K.id=="CUT")return {cw:w,ch:h,gw:w-0.25,gh:h-0.25,vw:w-1,vh:h-1,ex:0,basis:"cutout"};
 var cut=K.basis=="cutout"&&!(K.af&&rmin==45);
 if(cut)return {cw:w,ch:h,gw:w-0.25,gh:h-0.25,vw:w-1,vh:h-1,ex:0,basis:"cutout"};
 return {cw:w+0.25,ch:h+0.25,gw:w,gh:h,vw:w-0.75,vh:h-0.75,ex:0,basis:"glass"};}

function doorModel(I){
 var W=[],N=[],i,j,k,out={},ro={},items={};
 function V(n){var v=I[n];return v==null?"":(""+v);}
 function RO(n,b){ro[n]=b;}
 function SV(n,v){v=(v==null?"":""+v);if(V(n)!=v){I[n]=v;out[n]=v;}}
 function ITEMS(n,list,defv){items[n]=list;var keep=V(n);var want=(IDX(list,keep)>=0)?keep:defv;if(keep!=want){I[n]=want;out[n]=want;}}
 var mem=V("MEM").split("|");

 /* ---------- rating & series ---------- */
 var hand=V("Handing")||"LH",pair=/A$/.test(hand),hs0=hand.charAt(0);
 var fire=V("Fire Rating"),rmin=RMIN[fire]||0;

 var S=serBy(V("Series")),RLAB={0:"Non-rated",20:"20 Min.",45:"45 Min.",60:"60 Min.",90:"90 Min."};
 var sChg=S&&S.c!=(mem[3]||""),rChg=fire!=(mem[4]||fire);
 if(S&&S.r!=rmin&&(sChg||!rChg)){rmin=S.r;fire=RLAB[rmin];SV("Fire Rating",fire);}
 var rated=rmin>0;
 if(!S||S.r!=rmin){var old=S,pick=null;if(old)for(i=0;i<SER.length;i++)if(SER[i].r==rmin&&SER[i].eq==old.eq){pick=SER[i];break;}
  if(!pick)pick=serBy(SDEF[rmin]);S=pick;}
 var sItems=[];for(i=0;i<SER.length;i++)if(SER[i].r==rmin)sItems.push(serLab(SER[i]));
 ITEMS("Series",sItems,serLab(S));SV("Series",serLab(S));
 SV("Core",S.dt+"  |  "+S.core);
 if(S.por)N.push(S.c+" is not in the 2022 price list: confirm construction and price (P.O.R.).");
 if(S.c=="8120-MO")N.push("8120-MO: no added reinforcement available (use 8620-MO if needed); pairs with astragal only.");
 var tItems=S.t?['1-3/4"','1-3/8"']:['1-3/4"'];ITEMS("Thickness",tItems,'1-3/4"');
 var thin=V("Thickness")=='1-3/8"';

 /* ---------- opening & door size ---------- */
 var OW=PF(V("Opening W"));if(!(OW>=12))OW=36;
 var hp=V("Opening H"),OH=HPV[hp];
 if(hp=="Custom"){RO("Custom H",false);OH=PF(V("Custom H"));}else{RO("Custom H",true);if(OH)SV("Custom H",FF(OH));}
 if(!(OH>=24))OH=84;
 var uc=PF(V("Undercut").split(" ")[0]);if(uc==null)uc=0.75;
 var gap=0.125,LW=pair?(OW-0.375)/2:OW-0.25,DH=OH-0.125-uc,TW=pair?2*LW+gap:LW;
 SV("Door W",pair?("2 @ "+FF(LW)):FF(LW));SV("Door H",FF(DH));
 var leaves=pair?[{x:0,w:LW,hinge:"L",act:hs0=="L"},{x:LW+gap,w:LW,hinge:"R",act:hs0=="R"}]:[{x:0,w:LW,hinge:hs0,act:true}];
 var act=leaves[0];for(i=0;i<leaves.length;i++)if(leaves[i].act)act=leaves[i];
 var inact=pair?(act===leaves[0]?leaves[1]:leaves[0]):null;
 var nomW=pair?OW/2:OW;
 if(nomW>S.mW)W.push(S.c+" is listed to "+S.mW+"\" wide: "+FF(nomW)+" leaf is P.O.R.");
 if(OH>S.mH)W.push(S.c+" is listed to "+S.mH+"\" high: "+FT(OH)+" is P.O.R.");
 if(S.sr&&(nomW>48||OH>96))W.push("STC label tested up to 48\" x 96\": oversize ships without the STC label.");
 if(thin&&rated)W.push("Fire-rated doors are 1-3/4\" only.");

 /* ---------- face & finish ---------- */
 var fItems=[];for(i=0;i<S.f.length;i++)fItems.push(FACES[S.f[i]].n);
 var fDef=FACES[IDX(S.f,"NBR")>=0?"NBR":S.f[0]].n;
 ITEMS("Face",fItems,fDef);
 var FC=null,fk="";for(i=0;i<FK.length;i++)if(FACES[FK[i]].n==V("Face")){FC=FACES[FK[i]];fk=FK[i];}
 var mItems=FC.paint||FC.plam?["N/A (paint grade)"]:(fk=="ROR"?["S/R (std)","B/R","Other - P.O.R."]:["B/R (std)","S/R","Other - P.O.R."]);
 if(FC.plam)mItems=["N/A (laminate)"];
 ITEMS("Match",mItems,mItems[0]);
 if(FC.por)N.push("African mahogany is P.O.R.");
 var finItems=FC.plam?PLAMF:FIN;
 ITEMS("Finish",finItems,finItems[0]);
 var fin=V("Finish"),cItems=["N/A"],cDef="N/A",rgb=FC.rgb,stain=null;
 if(fin.indexOf("Standard stain")==0){cItems=[];for(i=0;i<STAINS.length;i++)cItems.push(STAINS[i][0]);cDef=cItems[3];}
 else if(fin.indexOf("Standard paint")==0){cItems=[];for(i=0;i<PAINTS.length;i++)cItems.push(PAINTS[i][0]);cDef=cItems[4];}
 else if(fin.indexOf("Custom")==0){cItems=["Specify colour / sample no."];cDef=cItems[0];}
 if(FC.plam){cItems=["Specify colour name / no."];cDef=cItems[0];}
 var col=V("Colour");
 if(fin.indexOf("Custom")==0||FC.plam){items["Colour"]=cItems;RO("Colour",false);if(col==""||col=="N/A")SV("Colour",cDef);
  for(i=0;i<STAINS.length;i++)if(col==STAINS[i][0])SV("Colour",cDef);for(i=0;i<PAINTS.length;i++)if(col==PAINTS[i][0])SV("Colour",cDef);}
 else{ITEMS("Colour",cItems,cDef);RO("Colour",cItems.length<2);}
 col=V("Colour");
 for(i=0;i<STAINS.length;i++)if(STAINS[i][0]==col&&fin.indexOf("Standard stain")==0){stain=STAINS[i];rgb=stain[1];}
 for(i=0;i<PAINTS.length;i++)if(PAINTS[i][0]==col&&fin.indexOf("Standard paint")==0)rgb=PAINTS[i][1];
 if(fin.indexOf("Custom paint")==0)rgb=[0.80,0.80,0.80];
 if(FC.plam)rgb=fin.indexOf("wood grain")>0?[0.80,0.66,0.50]:[0.86,0.86,0.84];
 if(FC.plam){if(col==""||col.indexOf("Specify")==0)W.push("Plastic laminate: type the colour name / number in the colour box.");
  if(fin.indexOf("P.O.R.")>0)N.push("Other laminate colours / special finishes: P.O.R.");
  if(!((nomW==48&&(OH==96||OH==120))))N.push("Plastic laminate is priced for 4'-0\" x 8'-0\" and 4'-0\" x 10'-0\"; other sizes P.O.R.");
  N.push("Laminate is added to the fibre board door price; over 50 doors ask for volume pricing.");}
 if(fin.indexOf("Custom stain")==0)rgb=[rgb[0]*0.75,rgb[1]*0.7,rgb[2]*0.65];
 if(fin.indexOf("Clear")==0)rgb=[rgb[0]*0.96,rgb[1]*0.92,rgb[2]*0.86];
 if(fin.indexOf("White primer")==0)rgb=[0.97,0.97,0.96];
 var isStain=fin.indexOf("stain")>=0,isPaint=fin.indexOf("paint")>=0||fin.indexOf("primer")>=0;
 if(isStain&&FC.paint)W.push("Stain needs a veneer face: "+FC.n.toLowerCase()+" is paint grade.");
 if(fin.indexOf("Clear")==0&&FC.paint)W.push("Clear finish on a paint grade face: pick a veneer or a paint.");
 if(isPaint&&!FC.paint&&fin.indexOf("primer")<0)N.push("Paint on a stain grade veneer: paint birch or fibre board costs less.");
 if(fin.indexOf("primer")==0&&!FC.primed)W.push("White primer sealer is for primed fibre board; other faces P.O.R.");
 if(stain&&stain[2]>=1&&FC.mah)W.push(stain[0]+" is not available in mahogany.");
 if(stain&&stain[2]==2&&FC.oak)W.push(stain[0]+" is not available in red oak.");
 if(fin.indexOf("Custom")==0)N.push("Custom colour: $853 development + signed sample approval.");

 /* ---------- hinges (Baillargeon standard: top of door to top of hinge) ---------- */
 var hpItems=["Butt hinge - mortised","SOSS concealed hinge","Pivots - top & bottom (90)","Pivots + intermediate (90 + 90 I)","Continuous hinge - no prep","No hinge prep"];
 ITEMS("Hinge Prep",hpItems,hpItems[0]);
 var ht=V("Hinge Prep"),butt=ht.indexOf("Butt")==0||ht.indexOf("SOSS")==0,soss=ht.indexOf("SOSS")==0,cont=ht.indexOf("Continuous")==0,piv=ht.indexOf("Pivots")==0;
 var hsItems=thin?['3-1/2" x 3-1/2"','3" x 3"']:['4-1/2" x 4" (std)','5" x 4-1/2" (PX)'];
 if(soss)hsItems=["Per SOSS model (specify)"];
