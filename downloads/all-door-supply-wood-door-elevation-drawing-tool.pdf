function PF(t){if(t==null)return null;t=(""+t).replace(/[\u201d\u2033]/g,'"').replace(/["\s]+$/,"").replace(/^\s+/,"");if(t=="")return null;
 var m=t.match(/^(\d+(?:\.\d+)?)(?:[\s-]+(\d+)\/(\d+))?$/);if(m){var v=parseFloat(m[1]);if(m[2])v+=parseInt(m[2],10)/parseInt(m[3],10);return v;}
 m=t.match(/^(\d+)\/(\d+)$/);if(m)return parseInt(m[1],10)/parseInt(m[2],10);
 m=t.match(/^(\d+)\s*'\s*-?\s*(\d+(?:\.\d+)?)?(?:[\s-]+(\d+)\/(\d+))?"?$/);if(m){var w=parseInt(m[1],10)*12+(m[2]?parseFloat(m[2]):0);if(m[3])w+=parseInt(m[3],10)/parseInt(m[4],10);return w;}
 return null;}
function FN(v){if(v==null||isNaN(v))return "";var neg=v<0;v=Math.abs(v);var w=Math.floor(v+1e-9),n=Math.round((v-w)*16);if(n==16){w++;n=0;}var s;if(n==0)s=""+w;else{var d=16;while(n%2==0){n/=2;d/=2;}s=(w>0?w+"-":"")+n+"/"+d;}return (neg?"-":"")+s;}
function FF(v){var s=FN(v);return s===""?"":s+'"';}
function FT(v){var n=Math.round(v*16)/16,ft=Math.floor(n/12),i=n-ft*12;return ft+"'-"+FN(i)+'"';}
