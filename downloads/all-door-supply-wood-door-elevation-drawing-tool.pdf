/* finishes: Baillargeon standard finish system */
var STAINS=[["Bourbon Caramel",[0.63,0.38,0.18],2],["Cinnamon Rolled Oats",[0.77,0.60,0.42],2],["Cocoa Bean",[0.35,0.23,0.16],0],["Espresso",[0.23,0.16,0.12],0],
 ["Nutmeg Cane",[0.55,0.35,0.17],1],["Saffron Honey",[0.78,0.57,0.24],1],["Stout Toast",[0.42,0.29,0.19],1],["Wild Rice",[0.61,0.53,0.41],0]];
